# Match local exclusions: .easignore replaces .gitignore for EAS uploads.
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# macOS
.DS_Store

# Local env files
.env
.env.local
.env.development
.env.production
.env.*
!.env.example

# Logs
*.log

# TypeScript
*.tsbuildinfo

# Expo
expo-env.d.ts

# Native project folders — generated by `expo prebuild` from
# app.json. Treat as build output (regenerated on demand for
# `expo run:ios` / `expo run:android` / EAS builds). Commit
# selectively only if you start editing Info.plist / Podfile
# / Gradle directly.
ios/
android/

# Local CocoaPods CDN workarounds (agent/dev only)
.cocoapods-specs/
ios/.cp-home/
ios/.cocoapods-specs/
ios/pod-install.log
ios/expo-run.log

# Full-resolution Bible Moment artwork; optimized assets are committed.
assets/bible-moments/original/

# Local native build output
/build/

# EAS Build upload exclusions.
#
# NOTE: Do NOT exclude `targets/` — Screen Time extensions
# (ActivityMonitor, ShieldAction, ShieldConfiguration) and their
# generated.entitlements must be present for iOS native builds.
#
# Exclude stale prebuild output — when `ios/` or `android/` exist
# locally, EAS uses the native AppIcon in that folder instead of
# app.json `icon`. An old blank placeholder icon was shipping on
# every TestFlight build until these are ignored and EAS prebuilds
# fresh from app.config.js.
ios/
android/

# Source cover masters — app uses compressed *.jpg only (see constants/bookCovers.ts).
assets/book-covers/Book of*
