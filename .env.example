EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Supabase — Project Settings → API (use the anon/public key, not service_role)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Sign-In — from Google Cloud Console (Web + iOS OAuth clients)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your_ios_client_suffix

# RevenueCat — Project Settings → API keys → Public Apple/iOS key (appl_…)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_public_key
