{
  "expo": {
    "name": "Closer",
    "slug": "closer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "closer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "exposdk:54.0.0",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.espinalcapital.closer",
      "appleTeamId": "7ZKDS4X5B9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416"
      },
      "package": "com.espinalcapital.closer"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "7ZKDS4X5B9",
          "appGroup": "group.com.espinalcapital.closer"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b5a953d-cc0a-4835-8a3b-af05f637a00d"
      }
    },
    "owner": "kennyespinal23",
    "updates": {
      "url": "https://u.expo.dev/2b5a953d-cc0a-4835-8a3b-af05f637a00d"
    }
  }
}
