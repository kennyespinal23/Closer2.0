{
  "expo": {
    "name": "Closer",
    "slug": "closer",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "closer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "exposdk:54.0.0",
    "splash": {
      "image": "./assets/splash-closer.png",
      "resizeMode": "cover",
      "backgroundColor": "#F93104"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.espinalcapital.closer",
      "appleTeamId": "7ZKDS4X5B9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Closer to access your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Closer to save scripture images to your photo library.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FC381C"
      },
      "package": "com.espinalcapital.closer"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Closer to access your photos.",
          "savePhotosPermission": "Allow Closer to save scripture images to your photo library."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "7ZKDS4X5B9",
          "appGroup": "group.com.espinalcapital.closer"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for Closer.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          "./assets/app-icons/alternates/Aurora.png",
          "./assets/app-icons/alternates/Berry.png",
          "./assets/app-icons/alternates/Blush.png",
          "./assets/app-icons/alternates/Citrus.png",
          "./assets/app-icons/alternates/CottonCandy.png",
          "./assets/app-icons/alternates/DeepSea.png",
          "./assets/app-icons/alternates/Dream.png",
          "./assets/app-icons/alternates/Earth.png",
          "./assets/app-icons/alternates/Ember.png",
          "./assets/app-icons/alternates/Forest.png",
          "./assets/app-icons/alternates/GoldenHour.png",
          "./assets/app-icons/alternates/Lagoon.png",
          "./assets/app-icons/alternates/Lime.png",
          "./assets/app-icons/alternates/Mist.png",
          "./assets/app-icons/alternates/Mountain.png",
          "./assets/app-icons/alternates/Night.png",
          "./assets/app-icons/alternates/Ocean.png",
          "./assets/app-icons/alternates/Paper.png",
          "./assets/app-icons/alternates/Peach.png",
          "./assets/app-icons/alternates/Periwinkle.png",
          "./assets/app-icons/alternates/Sage.png",
          "./assets/app-icons/alternates/Sand.png",
          "./assets/app-icons/alternates/Sky.png",
          "./assets/app-icons/alternates/Storm.png",
          "./assets/app-icons/alternates/Sunrise.png",
          "./assets/app-icons/alternates/Sunset.png",
          "./assets/app-icons/alternates/Twilight.png",
          "./assets/app-icons/alternates/VioletSky.png"
        ]
      ],
      [
        "./plugins/withPodDeploymentTarget",
        {
          "target": "16.0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b5a953d-cc0a-4835-8a3b-af05f637a00d"
      }
    },
    "owner": "kennyespinal23",
    "updates": {
      "url": "https://u.expo.dev/2b5a953d-cc0a-4835-8a3b-af05f637a00d"
    }
  }
}
