{
  "expo": {
    "name": "Closer",
    "slug": "closer",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "closer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "exposdk:54.0.0",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.espinalcapital.closer",
      "appleTeamId": "7ZKDS4X5B9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Closer to access your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Closer to save scripture images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.espinalcapital.closer"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Closer to access your photos.",
          "savePhotosPermission": "Allow Closer to save scripture images to your photo library."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "7ZKDS4X5B9",
          "appGroup": "group.com.espinalcapital.closer"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b5a953d-cc0a-4835-8a3b-af05f637a00d"
      }
    },
    "owner": "kennyespinal23",
    "updates": {
      "url": "https://u.expo.dev/2b5a953d-cc0a-4835-8a3b-af05f637a00d"
    }
  }
}
