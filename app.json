{
  "expo": {
    "name": "Closer",
    "slug": "closer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "closer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.closer.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.closer.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b5a953d-cc0a-4835-8a3b-af05f637a00d"
      }
    },
    "owner": "kennyespinal23",
    "updates": {
      "url": "https://u.expo.dev/2b5a953d-cc0a-4835-8a3b-af05f637a00d"
    }
  }
}
