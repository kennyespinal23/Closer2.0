{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "channel": "testflight"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "espinalcapital@gmail.com",
        "appleTeamId": "7ZKDS4X5B9",
        "ascAppId": "6779004238"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
